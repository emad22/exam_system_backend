    public function log(ProctoringSession $session, array $data): JsonResponse
    {
        $faceCount = $data['face_count'];

        // ✅ الحالة الطبيعية - 1 وش - لا تسجل خالص
        if ($faceCount === 1) {
            return response()->json(['success' => true, 'logged' => false]);
        }

        // ⚠️ مشكلة - مفيش وش أو أكتر من وش - سجل دي بس
        $violationType = match(true) {
            $faceCount === 0 => 'no_face_detected',
            $faceCount > 1   => 'multiple_faces_detected',
        };

        FaceDetectionLog::create([
            'session_id'     => $session->id,
            'face_count'     => $faceCount,
            'screenshot_url' => $data['screenshot'] ?? null,
            'violation_type' => $violationType,
        ]);

        // كمان سجل violation عشان الـ proctor يشوفها
        $session->violations()->create([
            'violation_type' => $violationType,
            'severity'       => $faceCount === 0 ? 'high' : 'medium',
            'description'    => $faceCount === 0
                ? 'No face detected in frame'
                : "Multiple faces detected: {$faceCount}",
            'evidence'       => ['screenshot' => $data['screenshot'] ?? null],
        ]);

        return response()->json(['success' => true, 'logged' => true, 'violation' => $violationType]);
    }





    private function checkFaceViolations(ProctoringSession $session, array $data): void
    {
        $faceCount = $data['face_count'] ?? 1;

        // وجه مختفي
        if ($faceCount === 0) {
            app(ViolationService::class)->report($session, [
                'violation_type' => 'face_not_visible',
                'severity'       => 'medium',
                'description'    => 'No face detected in frame',
                'evidence'       => [],
            ]);
            return;
        }

        // أكتر من وجه
        if ($faceCount > 1) {
            app(ViolationService::class)->report($session, [
                'violation_type' => 'multiple_faces',
                'severity'       => 'high',
                'description'    => "Multiple faces detected: {$faceCount} faces in frame",
                'evidence'       => [],
            ]);
        }
    }

    /**
     * Decide throttling (every 60 sec)
     */
    private function shouldRunCheck(ProctoringSession $session): bool
    {
        $deviceInfo = $session->device_info ?? [];
        $last = $deviceInfo['last_face_match_at'] ?? null;

        if (!$last) {
            return true;
        }

        try {
            return now()->diffInSeconds($last) >= 60;
        } catch (\Exception $e) {
            return true;
        }
    }

    /**
     * Core AI face comparison (Gemini fallback)
     */
    private function compareFaces(ProctoringSession $session, ?string $screenshotBase64, ?string $screenshotUrl)
    {
        $apiKey = config('services.gemini.api_key');

        if (!$apiKey || !$screenshotBase64) {
            return;
        }

        $registeredFaceUrl = $session->device_info['face_image'] ?? null;

        if (!$registeredFaceUrl) {
            return;
        }

        $registeredBase64 = $this->loadRegisteredFace($registeredFaceUrl);

        if (!$registeredBase64) {
            return;
        }

        $prompt = "Compare these two faces:
Image 1 = registered student
Image 2 = webcam capture

Return ONLY JSON:
{
  \"matched\": true/false,
  \"confidence_score\": 0,
  \"reason\": \"Arabic explanation\"
}";

        try {
            $response = Http::timeout(30)->post(
                "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key={$apiKey}",
                [
                    'contents' => [[
                        'parts' => [
                            ['text' => $prompt],
                            [
                                'inlineData' => [
                                    'mimeType' => 'image/jpeg',
                                    'data' => $registeredBase64
                                ]
                            ],
                            [
                                'inlineData' => [
                                    'mimeType' => 'image/jpeg',
                                    'data' => $this->toBase64($screenshotBase64)
                                ]
                            ]
                        ]
                    ]],
                    'generationConfig' => [
                        'temperature' => 0.1,
                        'responseMimeType' => 'application/json'
                    ]
                ]
            );

            if (!$response->successful()) {
                return;
            }

            $text = $this->cleanJson(
                $response->json('candidates.0.content.parts.0.text')
            );

            $result = json_decode($text, true);

            if (!isset($result['matched'])) {
                return;
            }

            // 4. Update session meta
            $session->update([
                'device_info' => array_merge($session->device_info ?? [], [
                    'last_face_match_at' => now()->toISOString(),
                    'last_face_match_ok' => $result['matched'],
                    'last_face_match_score' => $result['confidence_score'] ?? 0,
                    'last_face_match_reason' => $result['reason'] ?? '',
                ])
            ]);

            // 5. Handle violation
            if (!$result['matched'] || ($result['confidence_score'] ?? 0) < 70) {
                $this->createViolation($session, $result, $screenshotUrl);
            }

        } catch (\Exception $e) {
            \Log::error('Face comparison failed', [
                'error' => $e->getMessage()
            ]);
        }
    }

    /**
     * Create face swap violation
     */
    private function createViolation(ProctoringSession $session, array $result, ?string $screenshotUrl)
    {
        // ← استبدل الـ create اليدوي بـ ViolationService
        $violation = app(ViolationService::class)->report($session, [
            'violation_type' => 'face_swap',
            'severity'       => 'critical',
            'description'    => 'Face mismatch detected: ' . ($result['reason'] ?? ''),
            'evidence'       => $screenshotUrl ? [$screenshotUrl] : [],
        ]);

        app(ViolationService::class)->triggerAlert(
            $session,
            ExamViolation::find($violation->id)
        );
    }

    /**
     * Load stored face from storage URL
     */
    private function loadRegisteredFace(string $url): ?string
    {
        try {
            $disk = Storage::disk('public');

            $prefix = $disk->url('');
            $path = str_replace($prefix . '/', '', $url);

            if (!$disk->exists($path)) {
                return null;
            }

            return base64_encode($disk->get($path));

        } catch (\Exception $e) {
            return null;
        }
    }

    /**
     * Save image helper
     */
    private function storeImage($input, string $folder, string $name): ?string
    {
        try {
            $base64 = $this->toBase64($input);
            $binary = base64_decode($base64, true);

            if (!$binary) return null;

            $file = $folder . '/' . $name . '.jpg';

            Storage::disk('public')->put($file, $binary);

            return Storage::disk('public')->url($file);

        } catch (\Exception $e) {
            return null;
        }
    }

    private function toBase64($input): string
    {
        if (str_contains($input, ',')) {
            return explode(',', $input)[1];
        }

        return $input;
    }

    private function cleanJson(string $text): string
    {
        $text = trim($text);

        if (str_starts_with($text, '```')) {
            $text = preg_replace('/^```(?:json)?|```$/', '', $text);
        }

        return trim($text);
    }
}